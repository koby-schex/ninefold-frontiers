/* Approved sanctuary direction. Scoped to Home; battle HUD and other screens retain their layout. */
#home-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; background-image: url("Sanctuary.jpg"); -unity-background-scale-mode: scale-and-crop; }
.home-mode #safe-area { padding-left: 24px; padding-right: 24px; padding-bottom: 10px; }
.home-mode #screen-content { background-color: transparent; }
.home-masthead { flex-shrink: 0; padding-top: 22px; padding-bottom: 12px; background-color: rgba(10, 12, 20, 0.35); }
.home-wordmark { -unity-font-definition: url("DisplaySerif.ttf"); -unity-font-style: normal; font-size: 46px; letter-spacing: 7px; -unity-text-align: middle-center; color: rgb(247, 240, 222); margin: 0; }
.home-submark { -unity-font-definition: url("DisplaySerif.ttf"); -unity-font-style: normal; font-size: 15px; letter-spacing: 3px; -unity-text-align: middle-center; color: rgb(237, 229, 217); margin-top: 6px; }
.home-scroll { flex-grow: 1; min-height: 0; }
.home-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding: 0; }
.home-vista { min-height: 180px; flex-grow: 1; flex-shrink: 0; }
.home-actions { flex-shrink: 0; padding: 18px; background-color: rgba(10, 12, 21, 0.90); border-top-width: 1px; border-top-color: rgba(205, 192, 181, 0.55); }
.home-kicker { white-space: normal; font-size: 13px; letter-spacing: 2px; color: rgb(219, 207, 195); margin-bottom: 9px; }
.home-title { -unity-font-definition: url("DisplaySerif.ttf"); -unity-font-style: normal; white-space: normal; font-size: 48px; color: rgb(247, 240, 224); margin: 0; }
.home-summary { white-space: normal; font-size: 18px; color: rgb(211, 202, 218); margin-top: 10px; margin-bottom: 12px; }
.home-mode Button.home-primary { min-height: 78px; margin-top: 8px; margin-bottom: 12px; padding: 14px; border-radius: 3px; border-width: 2px; border-color: rgb(250, 235, 201); background-color: rgb(226, 211, 180); color: rgb(30, 27, 33); font-size: 20px; letter-spacing: 1px; -unity-font-style: bold; }
.home-mode Button.home-primary:hover { background-color: rgb(249, 233, 201); }
.home-mode Button.home-primary:active { background-color: rgb(198, 180, 151); }
.home-mode Button:focus { border-color: rgb(217, 187, 255); }
.home-shortcuts { flex-wrap: wrap; }
.home-shortcuts > Button.home-shortcut { min-width: 170px; flex-basis: 44%; flex-grow: 1; min-height: 128px; margin-right: 4px; margin-left: 4px; border-radius: 3px; border-color: rgb(124, 116, 138); background-color: rgba(28, 27, 42, 0.94); align-items: center; padding: 10px; }
.home-mode Button.home-shortcut:hover { background-color: rgb(49, 42, 61); }
.home-icon { width: 34px; height: 34px; flex-shrink: 0; margin-bottom: 5px; -unity-image-tint-color: rgb(240, 228, 217); }
.home-shortcut-title { -unity-font-definition: url("DisplaySerif.ttf"); -unity-font-style: normal; font-size: 21px; white-space: normal; color: rgb(240, 231, 220); -unity-text-align: middle-center; }
.home-shortcut-detail { font-size: 17px; -unity-font-style: normal; white-space: normal; color: rgb(196, 189, 207); margin-top: 5px; -unity-text-align: middle-center; }
.home-status { white-space: normal; font-size: 18px; color: rgb(229, 207, 178); margin-top: 6px; }
.home-fixture { white-space: normal; font-size: 12px; color: rgb(173, 163, 188); margin-top: 8px; -unity-text-align: middle-center; }
.home-navigation { flex-shrink: 0; background-color: rgba(11, 12, 22, 0.96); border-top-width: 1px; border-top-color: rgb(140, 126, 150); padding-top: 7px; }
.home-navigation > Button.home-nav-button { min-height: 84px; min-width: 0; margin: 0; border-radius: 0; border-width: 0; border-bottom-width: 3px; border-bottom-color: transparent; background-color: transparent; padding: 7px 2px; align-items: center; justify-content: center; }
.home-navigation > Button.home-nav-button.selected { border-bottom-color: rgb(204, 166, 249); background-color: rgba(119, 76, 150, 0.18); }
.home-navigation > Button.home-nav-button:hover { background-color: rgba(119, 76, 150, 0.28); }
.home-nav-label { font-size: 18px; color: rgb(228, 219, 235); white-space: normal; -unity-font-style: normal; -unity-text-align: middle-center; }
.home-mode Button:disabled { opacity: 0.45; }
.compact-home .home-vista { min-height: 30px; }
.compact-home .home-masthead { padding-top: 8px; padding-bottom: 6px; }
.compact-home .home-title { font-size: 38px; }
.compact-home .home-actions { padding: 12px; }

.short-home .home-masthead { display: none; }
.short-home .home-vista { min-height: 0; }
