/*
 * Ninefold: Frontiers — Game App Presentation 01
 * Source: official site identity plus approved World Five sanctuary game UI.
 * This is a touch-first TACTICS LOBBY rather than a website storefront.
 * Scope stays in presentation; no canonical symbols, map names, unit art or
 * gameplay state are generated by this stylesheet.
 */

/* Overlaid status rail and legible title float over the approved world image. */
.root.home-mode .game-lobby-masthead {
    padding: 8px 12px 8px 12px;
    background-color: rgba(14, 20, 17, 0.34);
    border-bottom-width: 1px;
    border-bottom-color: rgba(236, 224, 200, 0.16);
}
.root.home-mode .game-lobby-hud {
    width: 100%;
    flex-wrap: nowrap;
    justify-content: space-between;
    margin-bottom: 7px;
}
.root.home-mode .game-lobby-hud-world {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(243, 233, 212);
    background-color: rgba(15, 23, 18, 0.70);
    padding: 6px 8px;
    border-left-width: 2px;
    border-left-color: rgb(177, 166, 199);
}
.root.home-mode .game-lobby-hud-roster {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(240, 229, 201);
    background-color: rgba(15, 23, 18, 0.70);
    padding: 6px 8px;
    border-right-width: 2px;
    border-right-color: rgb(212, 180, 123);
}
.root.home-mode .game-lobby-masthead .home-wordmark {
    font-size: 41px;
    letter-spacing: 5px;
    color: rgb(251, 245, 232);
    -unity-text-align: middle-center;
    margin-bottom: 0;
}
.root.home-mode .game-lobby-masthead .home-submark {
    font-size: 12px;
    letter-spacing: 4px;
    color: rgb(230, 222, 209);
    -unity-text-align: middle-center;
    margin-top: 0;
}
.root.home-mode .game-lobby-scroll {
    background-color: transparent;
}
.root.home-mode .game-lobby-vista {
    flex-grow: 1;
    justify-content: flex-end;
    min-height: 145px;
    padding-left: 14px;
    padding-bottom: 11px;
}
.root.home-mode .game-lobby-scene-label {
    align-self: flex-start;
    font-size: 10px;
    letter-spacing: 2px;
    color: rgb(249, 239, 224);
    background-color: rgba(17, 23, 20, 0.78);
    border-left-width: 2px;
    border-left-color: rgb(177, 166, 199);
    padding: 7px 9px;
}

/* Mission control dock has the logic/information density of a native game UI.
 * The visual emphasis belongs to the gameplay action, not decorative cards. */
.root.home-mode .home-actions.game-lobby-dock {
    padding: 13px 15px 11px 15px;
    margin: 0;
    background-color: rgba(15, 22, 18, 0.97);
    border-top-width: 2px;
    border-top-color: rgb(212, 180, 123);
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 180, 123, 0.20);
}
.root.home-mode .game-lobby-status-line {
    align-items: center;
    margin-bottom: 3px;
}
.root.home-mode .game-lobby-status-line .home-kicker {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(221, 198, 151);
    margin: 0;
}
.root.home-mode .game-lobby-signal {
    font-size: 12px;
    color: rgb(177, 166, 199);
    margin-right: 7px;
}
.root.home-mode .game-lobby-title {
    font-size: 32px;
    color: rgb(249, 242, 227);
    margin: 1px 0 2px 0;
}
.root.home-mode .game-lobby-description {
    font-size: 14px;
    color: rgb(205, 205, 187);
    margin: 4px 0 11px 0;
    white-space: normal;
}
.root.home-mode #safe-area Button.game-button.game-lobby-primary {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 62px;
    padding: 9px 13px;
    margin: 2px 0 8px 0;
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: rgb(232, 215, 183);
    border-bottom-color: rgb(142, 112, 67);
    border-radius: 5px;
    background-color: rgb(212, 180, 123);
    color: rgb(16, 23, 18);
}
.root.home-mode #safe-area Button.game-button.game-lobby-primary:hover {
    background-color: rgb(239, 217, 171);
}
.root.home-mode #safe-area Button.game-button.game-lobby-primary:active {
    background-color: rgb(188, 155, 107);
    border-bottom-color: rgb(188, 155, 107);
}
.root.home-mode #safe-area Button.game-button.game-lobby-primary:focus {
    border-width: 2px;
    border-color: rgb(251, 244, 228);
}
.root.home-mode .game-lobby-primary > .home-icon {
    width: 25px;
    height: 25px;
    flex-shrink: 0;
    margin: 0 10px 0 0;
    -unity-image-tint-color: rgb(22, 31, 23);
}
.root.home-mode .game-lobby-primary-label {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(17, 23, 17);
}
.root.home-mode .game-lobby-primary-chevron {
    font-size: 24px;
    color: rgb(17, 23, 17);
    margin-left: 8px;
}
.root.home-mode #safe-area Button.game-button.game-lobby-secondary {
    min-height: 49px;
    padding: 9px 12px;
    margin: 0;
    border-width: 1px;
    border-color: rgba(171, 168, 145, 0.48);
    border-radius: 5px;
    background-color: rgba(42, 54, 44, 0.85);
    color: rgb(244, 237, 221);
    font-size: 14px;
    -unity-font-style: bold;
}
.root.home-mode #safe-area Button.game-button.game-lobby-secondary:hover {
    border-color: rgb(177, 166, 199);
    background-color: rgb(52, 65, 55);
}
.root.home-mode .game-lobby-assurance {
    font-size: 12px;
    color: rgb(195, 192, 173);
    margin: 8px 0 0 0;
}

/* Intentional abort/retreat is visibly different from Resume or Quick Battle.
 * The action is ONLY in the explicit confirmation state, never a shortcut. */
.root.home-mode #safe-area Button.game-button.game-lobby-danger {
    min-height: 54px;
    padding: 9px 12px;
    margin: 4px 0 7px 0;
    border-width: 1px;
    border-color: rgb(210, 161, 122);
    background-color: rgb(84, 51, 41);
    color: rgb(253, 232, 208);
    border-radius: 5px;
    font-size: 14px;
}
.root.home-mode #safe-area Button.game-button.game-lobby-danger:hover {
    background-color: rgb(105, 63, 49);
}
.root.home-mode #safe-area Button.game-button.game-lobby-cancel {
    min-height: 49px;
    padding: 8px;
    margin: 0;
    border-width: 1px;
    border-color: rgb(127, 139, 114);
    background-color: rgb(36, 49, 40);
    color: rgb(246, 239, 221);
    border-radius: 5px;
    font-size: 14px;
}
.root.home-mode #safe-area Button.game-button.game-lobby-cancel:hover {
    background-color: rgb(51, 65, 52);
}

/* The global four-tab HUD resembles a game command bar rather than a
 * web navigation footer. Equal tap zones; no new platform interactions. */
.root #safe-area .navigation.unified-navigation {
    padding: 4px 2px 2px 2px;
    border-top-width: 1px;
    border-top-color: rgba(212, 180, 123, 0.48);
    background-color: rgba(14, 21, 17, 0.99);
}
.root #safe-area .navigation.unified-navigation > Button.game-button.unified-nav-button {
    min-height: 66px;
    margin: 0 2px;
    padding: 5px 2px 4px 2px;
    background-color: rgba(43, 53, 43, 0.35);
    border-radius: 5px;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
}
.root #safe-area .navigation.unified-navigation > Button.game-button.unified-nav-button.selected {
    background-color: rgba(212, 180, 123, 0.12);
    border-bottom-color: rgb(212, 180, 123);
}
.root.home-mode #safe-area .navigation.unified-navigation > Button.game-button.unified-nav-button.selected {
    background-color: rgba(177, 166, 199, 0.14);
    border-bottom-color: rgb(177, 166, 199);
}
.root #safe-area .navigation.unified-navigation .unified-nav-button .home-icon {
    width: 26px;
    height: 26px;
    margin-bottom: 4px;
}
.root #safe-area .navigation.unified-navigation .nav-label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0;
    color: rgb(215, 213, 197);
}
.root #safe-area .navigation.unified-navigation .unified-nav-button.selected .nav-label {
    color: rgb(251, 244, 229);
}

/* During a saved encounter the player may *inspect* the campaign/roster
 * interfaces. This banner explains why deploy and upgrades are unavailable. */
.root.campaign-mode .game-saved-ribbon,
.root.collection-clarity-mode .game-saved-ribbon {
    font-size: 13px;
    white-space: normal;
    color: rgb(239, 221, 187);
    background-color: rgba(64, 54, 39, 0.87);
    border-left-width: 3px;
    border-left-color: rgb(212, 180, 123);
    padding: 10px 11px;
    margin: 5px 0 11px 0;
}

/* Match tactile game tiles across the existing contextual menus.
 * No extra ornamental flourishes, false icons or looping animations. */
.root.campaign-overview-mode .campaign-choice,
.root.mission-path-mode .mission-path-card,
.root.collection-clarity-mode .collection-detail-card {
    border-radius: 6px;
    border-top-width: 1px;
    border-top-color: rgba(212, 180, 123, 0.24);
    background-color: rgba(24, 34, 27, 0.97);
}
.root.campaign-overview-mode .campaign-choice-featured,
.root.mission-path-mode .mission-path-current {
    border-left-width: 3px;
    border-left-color: rgb(212, 180, 123);
    border-top-color: rgba(212, 180, 123, 0.68);
}
.root.mission-briefing-clarity-mode .mission-brief-objective,
.root.mission-briefing-clarity-mode .mission-brief-terrain,
.root.mission-briefing-clarity-mode .mission-brief-rewards {
    background-color: rgba(24, 34, 27, 0.97);
    border-top-color: rgba(212, 180, 123, 0.28);
}
.root.collection-clarity-mode #safe-area Button.game-button.collection-roster-entry {
    background-color: rgba(26, 36, 28, 0.98);
    border-left-width: 2px;
    border-left-color: rgba(177, 166, 199, 0.70);
}

/* 540×960 portrait reference; compact and short Editor views stay scrollable. */
.root.compact-home.home-mode .game-lobby-masthead { padding: 5px 9px 6px 9px; }
.root.compact-home.home-mode .game-lobby-masthead .home-wordmark { font-size: 34px; }
.root.compact-home.home-mode .game-lobby-vista { min-height: 35px; }
.root.compact-home.home-mode .home-actions.game-lobby-dock { padding: 11px 12px 9px 12px; }
.root.compact-home.home-mode .game-lobby-title { font-size: 27px; }
.root.compact-home.home-mode #safe-area Button.game-button.game-lobby-primary { min-height: 56px; }
.root.compact-home #safe-area .navigation.unified-navigation > Button.game-button.unified-nav-button { min-height: 58px; }
.root.short-home.home-mode .game-lobby-masthead { display: none; }
.root.short-home.home-mode .game-lobby-vista { min-height: 0; }
.root.short-home.home-mode .game-lobby-title { font-size: 25px; }
.root.short-home.home-mode .home-actions.game-lobby-dock { padding: 8px 10px; }
.root.short-home.home-mode #safe-area Button.game-button.game-lobby-primary { min-height: 44px; }
.root.short-home #safe-area .navigation.unified-navigation > Button.game-button.unified-nav-button { min-height: 44px; }
.root.short-home #safe-area .navigation.unified-navigation .unified-nav-button .home-icon { width: 18px; height: 18px; }
