/*
 * Ninefold: Frontiers — Collection Visual 03
 * UI-only, opt-in visual roster designed for real render thumbnails.
 * No prefab loading, render cameras or model mapping occurs here.
 */
.root.collection-clarity-mode #safe-area Button.game-button.vif-roster-tile {
    min-height: 116px;
    padding: 7px 9px;
    margin: 0 0 8px 0;
    border-width: 1px;
    border-left-width: 2px;
    border-color: rgba(125, 136, 113, 0.55);
    border-left-color: rgba(177, 166, 199, 0.58);
    border-radius: 6px;
    background-color: rgba(25, 35, 28, 0.97);
}
.root.collection-clarity-mode #safe-area Button.game-button.vif-roster-tile:hover {
    background-color: rgb(39, 52, 42);
    border-color: rgb(212, 180, 123);
}
.root.collection-clarity-mode #safe-area Button.game-button.vif-roster-tile:active {
    background-color: rgb(29, 41, 32);
}
.root.collection-clarity-mode #safe-area Button.game-button.vif-roster-tile:focus {
    border-width: 2px;
    border-color: rgb(246, 239, 221);
}
.root.collection-clarity-mode .vif-roster-portrait {
    width: 84px;
    height: 100px;
    min-width: 84px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    margin-right: 10px;
    border-width: 1px;
    border-color: rgba(177, 166, 199, 0.62);
    border-radius: 5px;
    background-color: rgb(30, 39, 36);
}
.root.collection-clarity-mode .vif-roster-portrait.vif-portrait-apex {
    border-color: rgb(212, 180, 123);
}
.root.collection-clarity-mode .vif-roster-portrait.vif-preview-locked {
    border-color: rgba(130, 132, 119, 0.42);
    background-color: rgb(25, 29, 28);
}
.root.collection-clarity-mode .vif-roster-portrait .vif-preview-image {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.root.collection-clarity-mode .vif-roster-fallback {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(58, 66, 65, 0.14);
}
.root.collection-clarity-mode .vif-roster-fallback-id {
    font-size: 26px;
    color: rgb(235, 226, 207);
}
.root.collection-clarity-mode .vif-roster-role {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    padding: 3px;
    background-color: rgba(12, 20, 17, 0.90);
}
.root.collection-clarity-mode .vif-roster-role-text {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(245, 235, 217);
}
.root.collection-clarity-mode .collection-roster-copy {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
}
.root.collection-clarity-mode .collection-roster-title {
    font-size: 22px;
    margin: 0 0 2px 0;
    color: rgb(246, 239, 221);
}
.root.collection-clarity-mode .collection-roster-state {
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin: 0 0 8px 0;
    color: rgb(217, 208, 186);
}
.root.collection-clarity-mode .vif-roster-resource {
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 5px 0;
}
.root.collection-clarity-mode .collection-roster-fragments {
    font-size: 12px;
    color: rgb(210, 206, 184);
    margin: 0;
}
.root.collection-clarity-mode .vif-roster-ready {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(231, 198, 133);
    margin: 0 0 0 6px;
}
.root.collection-clarity-mode .vif-roster-tile .progress-track {
    height: 5px;
    margin: 0;
    background-color: rgba(9, 16, 11, 0.95);
}
.root.collection-clarity-mode .vif-roster-tile .progress-fill {
    height: 5px;
    background-color: rgb(212, 180, 123);
}
.root.collection-clarity-mode .vif-roster-tile .collection-roster-arrow {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 24px;
    color: rgb(206, 186, 151);
}
.root.collection-clarity-mode .collection-detail-identity {
    padding: 0 2px;
    margin: 0 0 9px 0;
}
.root.collection-clarity-mode .collection-detail-copy {
    width: 100%;
    flex-grow: 1;
    min-width: 0;
}
.root.collection-clarity-mode .vif-model-fit {
    -unity-image-size: scale-to-fit;
}
.root.compact-home.collection-clarity-mode .vif-roster-portrait {
    width: 66px;
    height: 80px;
    min-width: 66px;
    margin-right: 8px;
}
.root.compact-home.collection-clarity-mode #safe-area Button.game-button.vif-roster-tile {
    min-height: 96px;
    padding: 7px;
}
.root.compact-home.collection-clarity-mode .collection-roster-title { font-size: 19px; }
.root.compact-home.collection-clarity-mode .vif-roster-fallback-id { font-size: 21px; }
.root.short-home.collection-clarity-mode .vif-roster-portrait {
    width: 64px;
    height: 76px;
    min-width: 64px;
}

/* Optional, nonexclusive lore-approved unit preview hints. */
.unit-preview-tag-strip {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 2px;
}
.unit-preview-tag {
    font-size: 10px;
    -unity-font-style: bold;
    color: #dfd5bb;
    background-color: #26362f;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: #6f715a;
    border-bottom-color: #6f715a;
    border-left-color: #6f715a;
    border-right-color: #6f715a;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    margin-right: 5px;
    margin-bottom: 4px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 3px;
    padding-bottom: 3px;
}

/* Individual unit hub: preview first, management tools below. */
.unit-profile-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}
.unit-profile-back {
    min-height: 42px;
    padding-left: 14px;
    padding-right: 14px;
}
.unit-profile-overline {
    color: #d1bd8c;
}
.unit-profile-viewer-card {
    min-height: 245px;
    margin-bottom: 12px;
    background-color: #152521;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: #6b624c;
    border-bottom-color: #6b624c;
    border-left-color: #6b624c;
    border-right-color: #6b624c;
}
.unit-profile-viewer-note {
    margin-top: 10px;
    font-size: 11px;
}
.unit-profile-secondary {
    margin-top: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.unit-profile-orbit-controls {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
}
.unit-profile-orbit-controls Button {
    min-height: 43px;
    margin-right: 5px;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
}
