/* Compact battlefield-first HUD. Fixed dock prevents confirmation moving the camera. */
.battle-mode .heading { display: none; }
.battle-mode #safe-area { padding: 0; }
.battle-mode .battle-header { padding: 4px 8px; margin: 0; border-width: 0; border-bottom-width: 1px; border-bottom-color: rgb(103, 93, 121); background-color: rgb(17, 18, 29); flex-shrink: 0; }
.battle-mode .battle-title-row { align-items: center; }
.battle-mode .battle-title-row > Button.game-button { flex-grow: 0; flex-basis: 76px; min-height: 76px; padding: 4px; font-size: 18px; }
.battle-mode .objective-text { flex-grow: 1; flex-shrink: 1; font-size: 19px; white-space: normal; -unity-text-align: middle-center; margin: 0 8px; }
.battle-stage { flex-grow: 1; min-height: 0; }
.battle-mode #battle-surface { flex-shrink: 1; min-width: 0; }
.battle-mode .battle-dock { height: 224px; background-color: rgb(17, 18, 29); border-top-width: 1px; border-top-color: rgb(117, 102, 135); }
.battle-mode .controls { padding: 4px 8px; background-color: rgb(17, 18, 29); }
.battle-mode .actor-status { font-size: 18px; color: rgb(232, 222, 200); margin: 2px 4px; height: 25px; white-space: nowrap; }
.battle-mode .battle-message { font-size: 17px; white-space: normal; color: rgb(192, 195, 215); margin: 2px 4px; }
.battle-mode Button.game-button { min-height: 76px; margin: 2px; padding: 6px; font-size: 19px; border-radius: 10px; }
.battle-mode Button.game-button.selected { background-color: rgb(61, 52, 78); border-color: rgb(214, 189, 245); color: rgb(255, 242, 220); }
.battle-mode .compact-preview { flex-grow: 1; flex-basis: 40%; flex-shrink: 1; white-space: normal; font-size: 18px; color: rgb(248, 222, 174); -unity-text-align: middle-left; padding-right: 5px; }
.battle-mode .ability-row > Button { min-width: 0; }
.battle-mode .battle-details { position: absolute; top: 8px; bottom: 8px; left: 12px; right: 12px; background-color: rgba(17, 18, 29, 0.98); border-width: 1px; border-color: rgb(145, 124, 166); border-radius: 12px; padding: 18px; }
.battle-mode .battle-details .section { font-size: 26px; }
.battle-mode .battle-details .detail { font-size: 21px; margin-bottom: 18px; }
.battle-mode .health-overlay { width: 76px; height: 28px; background-color: rgba(13, 14, 24, 0.82); border-radius: 4px; padding: 1px 3px; }
.battle-mode .health-overlay > Label { font-size: 15px; height: 16px; white-space: nowrap; }
.battle-mode .health-track, .battle-mode .health-fill { height: 4px; }
.battle-mode .turn-cue { top: 6px; left: 20%; right: 20%; padding: 5px; font-size: 18px; background-color: rgba(25, 26, 39, 0.9); }
.battle-mode .objective-marker { width: 32px; height: 32px; min-height: 32px; padding: 1px; font-size: 22px; border-radius: 16px; }
.short-home.battle-mode .battle-stage { flex-direction: row; }
.short-home.battle-mode .battle-dock { height: auto; width: 200px; border-top-width: 0; border-left-width: 1px; border-left-color: rgb(117, 102, 135); }
.short-home.battle-mode .battle-header { padding: 2px 6px; }
.short-home.battle-mode .battle-title-row > Button.game-button { min-height: 32px; flex-basis: 48px; font-size: 12px; }
.short-home.battle-mode .objective-text { font-size: 13px; }
.short-home.battle-mode .actor-status { font-size: 12px; height: 20px; }
.short-home.battle-mode Button.game-button { min-height: 36px; font-size: 12px; padding: 3px; }
.short-home.battle-mode .ability-row { flex-wrap: wrap; }
.short-home.battle-mode .ability-row > Button { flex-basis: 28%; }
.short-home.battle-mode .compact-preview { flex-basis: 100%; font-size: 12px; }
.short-home.battle-mode .battle-message { font-size: 12px; }
.short-home.battle-mode .battle-details .detail { font-size: 14px; margin-bottom: 8px; }
.short-home.battle-mode .battle-details .section { font-size: 18px; }
