/* Shared sanctuary interface materials, not new faction/world art. */
.campaign-mode #home-backdrop { opacity: 0.18; }
.campaign-mode #safe-area { padding-left: 22px; padding-right: 22px; }
.campaign-mode .heading { background-color: rgba(11, 13, 22, 0.95); border-bottom-color: rgb(105, 93, 120); padding-top: 10px; }
.campaign-mode .brand { -unity-font-definition: url("DisplaySerif.ttf"); -unity-font-style: normal; font-size: 30px; letter-spacing: 5px; }
.campaign-mode .heading > .eyebrow { display: none; }
.campaign-mode .notice { font-size: 16px; min-height: 24px; color: rgb(189, 180, 202); }
.campaign-mode .page-scroll { background-color: rgba(11, 13, 22, 0.86); padding: 14px 10px 0 10px; }
.campaign-mode .display-title { -unity-font-definition: url("DisplaySerif.ttf"); -unity-font-style: normal; font-size: 42px; color: rgb(246, 235, 219); }
.campaign-mode .section { font-size: 25px; color: rgb(240, 230, 217); }
.campaign-mode .detail { font-size: 20px; color: rgb(215, 207, 223); }
.campaign-mode .hint { font-size: 17px; color: rgb(183, 177, 199); }
.campaign-mode .eyebrow, .campaign-status { font-size: 15px; letter-spacing: 1px; color: rgb(221, 204, 178); white-space: normal; margin-top: 5px; margin-bottom: 7px; }
.campaign-mode .card { background-color: rgba(24, 24, 38, 0.98); border-color: rgb(99, 87, 114); border-radius: 4px; padding: 18px; margin-top: 8px; margin-bottom: 14px; }
.campaign-mode .campaign-panel { border-top-width: 3px; border-top-color: rgb(193, 167, 224); }
.campaign-name { -unity-font-definition: url("DisplaySerif.ttf"); -unity-font-style: normal; font-size: 32px; color: rgb(245, 233, 213); white-space: normal; margin-top: 4px; margin-bottom: 10px; }
.campaign-mode .progress-track { height: 7px; margin-top: 10px; margin-bottom: 10px; background-color: rgb(10, 11, 19); }
.campaign-mode .progress-fill { background-color: rgb(186, 154, 219); }
.lock-reason { font-size: 18px; white-space: normal; color: rgb(220, 199, 170); padding: 12px; margin-top: 8px; margin-bottom: 6px; background-color: rgb(37, 31, 37); border-left-width: 2px; border-left-color: rgb(174, 144, 107); }
.next-mission-label { font-size: 17px; white-space: normal; color: rgb(220, 199, 242); margin-top: 10px; margin-bottom: 5px; }
.campaign-mode Button { min-height: 76px; font-size: 20px; border-radius: 3px; background-color: rgb(36, 32, 48); border-color: rgb(115, 102, 132); color: rgb(235, 225, 218); padding: 14px; }
.campaign-mode Button:hover { background-color: rgb(53, 43, 66); }
.campaign-mode Button.primary { background-color: rgb(226, 211, 180); color: rgb(30, 27, 33); border-color: rgb(248, 231, 195); }
.campaign-mode Button.primary:hover { background-color: rgb(249, 233, 201); }
.campaign-mode Button:disabled { background-color: rgb(26, 25, 36); color: rgb(151, 143, 164); border-color: rgb(65, 57, 75); }
.campaign-mode Button:focus { border-color: rgb(231, 191, 255); }
.campaign-mode Button.back-link { background-color: transparent; border-width: 0; -unity-text-align: middle-left; margin-bottom: 4px; }
.campaign-mode .locked-card { background-color: rgb(20, 20, 30); border-color: rgb(65, 58, 74); }
.campaign-mode .next-mission { border-left-width: 4px; border-left-color: rgb(204, 168, 238); }
.mission-heading { align-items: center; }
.mission-number { -unity-font-definition: url("DisplaySerif.ttf"); font-size: 34px; color: rgb(162, 140, 184); min-width: 58px; margin-right: 12px; }
.mission-identity { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.fixture-note { font-size: 15px; white-space: normal; color: rgb(168, 157, 185); margin: 8px 0; }
.campaign-mode .step-label { font-size: 16px; color: rgb(205, 181, 228); }
.campaign-mode .map-preview { height: 270px; border-color: rgb(143, 125, 166); background-color: rgb(11, 14, 23); }
.campaign-mode .briefing-terrain { padding: 14px; }
.campaign-mode .briefing-objective { border-left-width: 3px; border-left-color: rgb(218, 198, 159); }
.briefing-reward { align-items: center; padding: 12px 0; border-bottom-width: 1px; border-bottom-color: rgb(61, 53, 74); }
.reward-name { font-size: 19px; white-space: normal; color: rgb(223, 214, 231); flex-grow: 1; flex-shrink: 1; }
.reward-amount { font-size: 23px; color: rgb(241, 218, 180); margin-left: 12px; }
.campaign-mode .deploy-dock { flex-shrink: 0; background-color: rgb(17, 17, 28); border-color: rgb(137, 117, 153); margin: 0; padding: 10px 16px; }
.campaign-mode .navigation { background-color: rgb(14, 14, 24); border-top-color: rgb(101, 87, 115); }
.campaign-mode .navigation > Button { font-size: 18px; min-height: 76px; padding: 8px 2px; background-color: transparent; }
.campaign-mode .navigation > Button.selected { color: rgb(235, 209, 255); border-bottom-color: rgb(201, 163, 239); background-color: rgb(39, 28, 48); }
.compact-home.campaign-mode .map-preview { height: 190px; }
.short-home.campaign-mode .heading { display: none; }
