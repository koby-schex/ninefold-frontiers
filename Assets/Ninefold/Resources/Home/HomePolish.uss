/*
 * Home clarity pass 02 — focused, uncluttered presentation.
 * Scoped entirely to Home. Approved sanctuary artwork stays untouched.
 * This is not a replacement for production-resolution art and 3D units.
 */

/* Site-aligned ink/ivory/gold stays quiet so World Five's approved
 * atmosphere and silver-violet light remain the dominant imagery. */
.root.home-mode #safe-area {
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 6px;
}
.root.home-mode .home-masthead {
    padding-top: 19px;
    padding-bottom: 12px;
    background-color: rgba(17, 22, 17, 0.22);
}
.root.home-mode .home-wordmark {
    font-size: 38px;
    letter-spacing: 5px;
    color: rgb(246, 239, 221);
}
.root.home-mode .home-submark {
    font-size: 13px;
    letter-spacing: 4px;
    margin-top: 3px;
    color: rgb(225, 218, 207);
}
.root.home-mode .home-vista {
    min-height: 160px;
}

/* The approved World Five sanctuary is the hero. Information occupies only
 * a compact, readable lower dock rather than a stack of oversized cards. */
.root.home-mode .home-actions {
    padding: 17px 18px 15px 18px;
    background-color: rgba(17, 22, 17, 0.94);
    border-top-width: 1px;
    border-top-color: rgba(212, 180, 123, 0.55);
}
.root.home-mode .home-kicker {
    margin-bottom: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(212, 180, 123);
}
.root.home-mode .home-title {
    margin: 0;
    font-size: 38px;
    white-space: normal;
    color: rgb(246, 239, 221);
}
.root.home-mode .home-summary {
    margin-top: 7px;
    margin-bottom: 12px;
    font-size: 15px;
    white-space: normal;
    color: rgb(214, 208, 193);
}

/* Primary action: visually unmistakable, but never a giant glossy tile. */
.root.home-mode #safe-area Button.game-button.home-primary {
    min-height: 59px;
    margin: 4px 0 5px 0;
    padding: 11px;
    border-width: 1px;
    border-bottom-width: 2px;
    border-color: rgb(231, 209, 165);
    border-bottom-color: rgb(114, 90, 58);
    border-radius: 5px;
    background-color: rgb(212, 180, 123);
    color: rgb(17, 22, 17);
    font-size: 17px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}
.root.home-mode #safe-area Button.game-button.home-primary:hover {
    background-color: rgb(238, 218, 174);
    border-color: rgb(246, 239, 221);
}
.root.home-mode #safe-area Button.game-button.home-primary:active {
    background-color: rgb(183, 149, 101);
    border-bottom-color: rgb(183, 149, 101);
}
.root.home-mode #safe-area Button.game-button.home-primary:focus {
    border-width: 2px;
    border-color: rgb(246, 239, 221);
}

/* Quick Battle is one calm alternative. Unit browsing is already a tab. */
.root.home-mode #safe-area Button.game-button.home-quick-link {
    min-height: 50px;
    margin: 2px 0 0 0;
    padding: 7px 12px;
    border-width: 1px;
    border-color: rgba(171, 168, 145, 0.44);
    border-radius: 5px;
    background-color: rgba(34, 45, 36, 0.86);
    color: rgb(230, 224, 211);
    font-size: 15px;
    -unity-font-style: normal;
}
.root.home-mode #safe-area Button.game-button.home-quick-link:hover {
    background-color: rgb(48, 60, 50);
    border-color: rgb(212, 180, 123);
}
.root.home-mode #safe-area Button.game-button.home-quick-link:active {
    background-color: rgb(27, 39, 30);
}
.root.home-mode #safe-area Button.game-button.home-quick-link:focus {
    border-width: 2px;
    border-color: rgb(246, 239, 221);
}
.root.home-mode .home-status {
    margin-top: 7px;
    font-size: 13px;
    color: rgb(212, 180, 123);
    white-space: normal;
}

/* Quiet fixed navigation provides reliable orientation without repeating
 * shortcut cards. Individual worlds may change accents after canon review. */
.root.home-mode #safe-area .navigation {
    padding: 3px 0 0 0;
    background-color: rgba(17, 22, 17, 0.98);
    border-top-width: 1px;
    border-top-color: rgba(212, 180, 123, 0.35);
}
.root.home-mode #safe-area Button.game-button.nav-button {
    min-width: 0;
    min-height: 62px;
    margin: 0 1px;
    padding: 5px 2px;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-radius: 0;
    background-color: transparent;
    color: rgb(219, 211, 197);
    opacity: 1;
}
.root.home-mode #safe-area Button.game-button.nav-button.selected {
    background-color: rgba(177, 166, 199, 0.10);
    border-bottom-color: rgb(177, 166, 199);
}
.root.home-mode #safe-area Button.game-button.nav-button:hover {
    background-color: rgba(177, 166, 199, 0.13);
}
.root.home-mode #safe-area Button.game-button.nav-button:focus {
    border-top-width: 2px;
    border-top-color: rgb(246, 239, 221);
}
.root.home-mode #safe-area Button.game-button.nav-button:disabled {
    background-color: transparent;
    border-bottom-color: transparent;
    color: rgb(126, 130, 119);
    opacity: 0.62;
}
.root.home-mode #safe-area .nav-label {
    font-size: 14px;
    color: rgb(220, 212, 198);
    white-space: normal;
    -unity-text-align: middle-center;
}
.root.home-mode #safe-area .nav-button.selected .nav-label {
    color: rgb(246, 239, 221);
}
.root.home-mode #safe-area .nav-button:disabled .nav-label {
    color: rgb(138, 137, 128);
}
.root.home-mode #safe-area .nav-button .home-icon {
    width: 23px;
    height: 23px;
    margin-bottom: 3px;
}

/* In compact portraits, shorten decoration before shrinking touch controls. */
.root.compact-home.home-mode .home-masthead {
    padding-top: 10px;
    padding-bottom: 8px;
}
.root.compact-home.home-mode .home-wordmark {
    font-size: 33px;
    letter-spacing: 4px;
}
.root.compact-home.home-mode .home-title {
    font-size: 31px;
}
.root.compact-home.home-mode .home-actions {
    padding: 13px 15px;
}
.root.compact-home.home-mode .home-vista {
    min-height: 35px;
}
.root.compact-home.home-mode #safe-area Button.game-button.home-primary {
    min-height: 56px;
}
.root.compact-home.home-mode #safe-area Button.game-button.nav-button {
    min-height: 58px;
}

/* Short landscape is for editor reachability, not a production portrait
 * arrangement. Scroll the dock; preserve the navigation and action labels. */
.root.short-home.home-mode .home-masthead {
    display: none;
}
.root.short-home.home-mode .home-vista {
    min-height: 0;
}
.root.short-home.home-mode .home-title {
    font-size: 27px;
}
.root.short-home.home-mode .home-actions {
    padding: 10px 12px;
}
.root.short-home.home-mode #safe-area Button.game-button.home-primary {
    min-height: 44px;
    padding: 6px 9px;
    font-size: 14px;
}
.root.short-home.home-mode #safe-area Button.game-button.home-quick-link {
    min-height: 44px;
    padding: 6px 9px;
    font-size: 13px;
}
.root.short-home.home-mode #safe-area Button.game-button.nav-button {
    min-height: 44px;
}
.root.short-home.home-mode #safe-area .nav-label {
    font-size: 12px;
}
.root.short-home.home-mode #safe-area .nav-button .home-icon {
    width: 18px;
    height: 18px;
}
