.root { flex-grow: 1; color: rgb(233, 241, 246); font-size: 16px; background-color: rgb(8, 15, 23); }
#safe-area { position: absolute; padding-left: 16px; padding-right: 16px; padding-bottom: 8px; }
#screen-content { flex-grow: 1; min-height: 0; }
.heading { flex-shrink: 0; padding-top: 14px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgb(39, 59, 73); }
.brand { font-size: 27px; -unity-font-style: bold; letter-spacing: 5px; }
.eyebrow { font-size: 11px; -unity-font-style: bold; color: rgb(224, 187, 115); margin-top: 8px; margin-bottom: 6px; letter-spacing: 1px; white-space: normal; }
.notice { font-size: 12px; white-space: normal; min-height: 30px; margin-top: 8px; color: rgb(170, 196, 211); }
.page-scroll { flex-grow: 1; min-height: 0; padding-top: 12px; }
.page-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-right: 5px; padding-bottom: 12px; }
.display-title { font-size: 28px; -unity-font-style: bold; white-space: normal; margin-top: 4px; margin-bottom: 8px; }
.section { font-size: 18px; -unity-font-style: bold; margin-top: 4px; margin-bottom: 6px; white-space: normal; }
.detail { font-size: 14px; white-space: normal; margin-top: 4px; margin-bottom: 6px; color: rgb(195, 212, 224); }
.hint { font-size: 12px; white-space: normal; color: rgb(164, 187, 204); margin-top: 4px; margin-bottom: 4px; }
.preview, .reward-list { font-size: 15px; white-space: normal; color: rgb(246, 212, 148); margin-top: 5px; margin-bottom: 5px; }
.card { background-color: rgb(17, 30, 43); border-width: 1px; border-color: rgb(44, 65, 81); border-radius: 12px; padding: 14px; margin-bottom: 12px; flex-shrink: 0; }
.hero { background-color: rgb(22, 46, 59); border-left-width: 4px; border-left-color: rgb(105, 213, 210); padding: 20px; }
.locked-card { background-color: rgb(19, 26, 36); border-color: rgb(44, 52, 66); }
.confirmation { border-color: rgb(224, 187, 115); background-color: rgb(43, 40, 33); }
Button { min-height: 46px; flex-shrink: 0; margin-top: 5px; margin-bottom: 5px; margin-left: 0; margin-right: 0; padding: 10px; background-color: rgb(29, 49, 65); color: rgb(234, 245, 248); border-width: 1px; border-color: rgb(68, 96, 113); border-radius: 8px; white-space: normal; font-size: 15px; -unity-font-style: bold; }
Button:hover { background-color: rgb(39, 71, 87); border-color: rgb(126, 188, 199); }
Button:active, Button.selected { background-color: rgb(30, 70, 79); border-color: rgb(118, 229, 221); }
Button:focus { border-color: rgb(235, 210, 151); }
Button:disabled { background-color: rgb(25, 34, 45); color: rgb(135, 154, 170); border-color: rgb(49, 63, 76); }
Button.primary { background-color: rgb(114, 216, 204); color: rgb(9, 32, 39); border-color: rgb(156, 241, 225); min-height: 50px; }
Button.primary:hover { background-color: rgb(158, 237, 226); }
Button.primary:disabled { background-color: rgb(35, 67, 72); color: rgb(143, 174, 180); border-color: rgb(58, 97, 101); }
.row { flex-direction: row; align-items: stretch; }
.row > Button { flex-grow: 1; flex-basis: 0; margin-right: 5px; }
.navigation { flex-shrink: 0; border-top-width: 1px; border-top-color: rgb(50, 71, 86); padding-top: 7px; background-color: rgb(8, 15, 23); }
.navigation > Button { font-size: 13px; border-width: 0; min-height: 52px; background-color: rgb(15, 27, 38); }
.navigation > Button.selected { border-bottom-width: 3px; border-bottom-color: rgb(118, 229, 221); color: rgb(146, 234, 225); }
.unit-grid { flex-wrap: wrap; }
.unit-grid > Button.unit-tile { flex-grow: 0; flex-basis: 47%; margin-right: 2%; min-width: 0; padding: 12px; -unity-text-align: upper-left; align-items: flex-start; }
.unit-tile.selected { border-width: 2px; }
.unit-badge { width: 60px; height: 60px; border-radius: 30px; border-width: 3px; border-color: rgb(103, 217, 220); background-color: rgb(17, 58, 72); justify-content: center; align-items: center; margin-bottom: 6px; }
.unit-badge.faction-b { border-color: rgb(180, 158, 240); background-color: rgb(46, 36, 70); }
.unit-badge.apex-badge { border-radius: 9px; border-color: rgb(237, 193, 107); }
.badge-id { font-size: 22px; -unity-font-style: bold; color: rgb(236, 245, 248); }
.tile-state { margin-top: 8px; font-size: 11px; color: rgb(162, 233, 220); white-space: normal; }
.stat-row { flex-wrap: wrap; }
.stat { flex-basis: 47%; flex-grow: 1; margin-right: 6px; padding: 8px; background-color: rgb(11, 23, 34); }
.stat .hint { font-size: 10px; }
.progress-track { height: 7px; flex-shrink: 0; border-radius: 4px; background-color: rgb(7, 18, 28); overflow: hidden; margin-top: 6px; margin-bottom: 6px; }
.progress-fill { height: 7px; background-color: rgb(114, 216, 204); }
.deploy-dock { margin-bottom: 0; padding: 10px; border-color: rgb(69, 120, 126); }
.map-preview { height: 150px; margin-top: 4px; margin-bottom: 5px; background-color: rgb(8, 19, 29); border-width: 2px; border-color: rgb(96, 131, 146); overflow: hidden; }
.map-cover { background-color: rgb(98, 124, 141); border-width: 1px; border-color: rgb(161, 185, 195); }
.map-slow { background-color: rgb(118, 89, 43); }
.map-objective { background-color: rgb(242, 194, 89); }
.map-deploy { background-color: rgb(96, 236, 221); border-radius: 5px; }
.battle-mode .brand { font-size: 17px; letter-spacing: 3px; }
.root.battle-mode { background-color: transparent; }
.battle-mode .heading { padding-top: 6px; padding-bottom: 3px; }
.battle-mode .heading > .eyebrow { display: none; }
.battle-mode .notice { min-height: 28px; margin-top: 2px; font-size: 11px; }
.battle-header { padding: 8px; margin-top: 6px; margin-bottom: 4px; }
.battle-header .row > .section { flex-grow: 1; flex-shrink: 1; font-size: 15px; }
.battle-header .row > Button { flex-grow: 0; flex-basis: 66px; min-height: 36px; font-size: 12px; padding: 5px; margin-top: 0; margin-bottom: 0; }
.objective-text { font-size: 13px; color: rgb(243, 208, 141); white-space: normal; margin-bottom: 5px; }
.turn-strip { margin-top: 4px; }
.current-turn, .turn-chip { padding: 5px; margin-right: 4px; border-radius: 4px; font-size: 11px; background-color: rgb(31, 48, 62); }
.current-turn { color: rgb(158, 239, 225); background-color: rgb(27, 66, 73); -unity-font-style: bold; }
#battle-surface { background-color: transparent; }
.battle-dock { height: 280px; flex-shrink: 0; border-top-width: 2px; border-top-color: rgb(57, 91, 106); }
.controls { padding-top: 7px; padding-bottom: 4px; padding-left: 3px; padding-right: 3px; background-color: rgb(9, 18, 28); }
.actor-status { font-size: 13px; -unity-font-style: bold; white-space: normal; color: rgb(206, 235, 235); }
.ability-button { min-height: 60px; font-size: 13px; }
.intent-row { align-items: center; background-color: rgb(40, 40, 31); padding: 5px; border-radius: 7px; }
.intent-row > .preview { flex-grow: 1; flex-shrink: 1; font-size: 12px; }
.intent-row > Button { flex-grow: 0; flex-basis: 125px; font-size: 13px; }
.legend { font-size: 10px; color: rgb(158, 185, 201); white-space: normal; margin-top: 4px; }
.health-overlay { position: absolute; width: 96px; height: 32px; background-color: rgba(7, 14, 22, 0.96); border-radius: 5px; padding-left: 4px; padding-right: 4px; padding-top: 2px; border-left-width: 3px; border-left-color: rgb(101, 228, 218); }
.health-overlay.enemy-health { border-left-color: rgb(255, 121, 101); }
.health-overlay.active-health { border-top-width: 2px; border-top-color: rgb(250, 216, 129); }
.health-overlay > Label { font-size: 11px; -unity-text-align: middle-center; color: white; height: 18px; }
.health-track { height: 5px; background-color: rgb(57, 68, 79); }
.health-fill { height: 5px; }
